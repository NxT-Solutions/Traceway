---
import Base from '../layouts/Base.astro';

const sports = [
    ['Run', 'Paths and pavements. Busy roads lose.'],
    ['Trail run', 'Dirt and footpaths, with the climb left in.'],
    ['Walk and hike', 'A shorter day, at a walking pace, on paths and trails.'],
    ['Road', 'Paved roads and cycleways. Quiet streets over trunk roads.'],
    ['Gravel', 'Smooth unpaved where the map knows it. Pavement is still allowed.'],
    ['Mountain bike', 'Trails and rougher track. Hills are part of the point.'],
];

const sessions = [
    ['Brick', 'A ride, then a run straight off the bike.'],
    ['Triathlon', 'A swim you draw on the water, then a ride and a run on the roads.'],
    ['Duathlon', 'A run, a ride, and a run again.'],
    ['Aquabike', 'A swim, then a ride. No run.'],
];
---

<Base
    title="Sports"
    description="Foot and bike, each with its own idea of a good line, alone or together in one multisport plan."
    current="sports"
>
    <main class="wrap page">
        <p class="kicker">Sports</p>
        <h1>Foot and bike. One profile each.</h1>
        <ul class="rows">
            {
                sports.map(([name, copy]) => (
                    <li>
                        <div class="row">
                            <h2>{name}</h2>
                            <p>{copy}</p>
                        </div>
                    </li>
                ))
            }
        </ul>
        <h2 class="page-sub">Several in one plan.</h2>
        <p class="page-lede">
            Multisport puts legs together. Each leg keeps its own sport, so a
            run still scores busy roads down inside a triathlon. Pick a race
            distance, from a super sprint to a full Ironman, or set each leg.
        </p>
        <ul class="rows">
            {
                sessions.map(([name, copy]) => (
                    <li>
                        <div class="row">
                            <h2>{name}</h2>
                            <p>{copy}</p>
                        </div>
                    </li>
                ))
            }
        </ul>
        <div class="page-cta">
            <a class="fill" href="/dashboard">Open the planner</a>
            <small>Loops for every sport, and plans for several.</small>
        </div>
    </main>
</Base>
