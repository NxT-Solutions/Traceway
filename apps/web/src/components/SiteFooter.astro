---
import Mark from './Mark.astro';

interface Props {
    home?: boolean;
}

const { home = false } = Astro.props;
const at = (hash: string): string => (home ? hash : `/${hash}`);
---

<footer class="site-foot">
    <div class="wrap foot">
        <a class="brand" href={home ? '#top' : '/'}>
            <Mark size={22} />
            <span>Traceway</span>
        </a>
        <div class="cols">
            <div>
                <h2>Page</h2>
                <ul>
                    <li><a href={at('#how')}>How it works</a></li>
                    <li><a href={at('#sports')}>Sports</a></li>
                    <li><a href={at('#multisport')}>Multisport</a></li>
                    <li><a href={at('#devices')}>Devices</a></li>
                    <li><a href={at('#faq')}>Questions</a></li>
                </ul>
            </div>
            <div>
                <h2>Account</h2>
                <ul>
                    <li><a href="/login">Log in</a></li>
                    <li><a href="/dashboard">Open the planner</a></li>
                    <li><a href="/status">Service status</a></li>
                    <li><a href="/support">Support Traceway</a></li>
                </ul>
            </div>
            <div>
                <h2>Legal</h2>
                <ul>
                    <li><a href="/privacy">Privacy policy</a></li>
                    <li><a href="/terms">Terms of use</a></li>
                    <li><a href="/cookies">Cookies</a></li>
                    <li><a href="/legal">Legal notice</a></li>
                    <li>
                        <button type="button" class="link-button" data-consent-open>Cookie choice</button>
                    </li>
                </ul>
            </div>
        </div>
        <div class="line">
            <span
                >Loops for every sport. Free, kept running by <a
                    href="/support">donations</a
                >.</span
            >
            <span>Map data from OpenStreetMap.</span>
        </div>
    </div>
</footer>
