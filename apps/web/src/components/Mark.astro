    viewBox="0 0 28 28"
    fill="none"
    aria-hidden="true"
>
    <path
        class="mk"
        d="M6 23 V12 a6 6 0 0 1 6 -6 h4 a6 6 0 0 1 6 6 v3"
        stroke="currentColor"
