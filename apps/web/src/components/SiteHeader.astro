---
import Mark from './Mark.astro';

interface Props {
    /** On the home page the section links scroll in place. */
    home?: boolean;
    /** The link to mark as the current page. */
    current?: 'how' | 'sports' | 'devices' | 'faq' | 'notes';
}

const { home = false, current } = Astro.props;
const at = (hash: string): string => (home ? hash : `/${hash}`);
const links = [
    { key: 'how', href: at('#how'), label: 'How it works' },
    { key: 'sports', href: at('#sports'), label: 'Sports' },
    { key: 'multisport', href: at('#multisport'), label: 'Multisport' },
    { key: 'devices', href: at('#devices'), label: 'Devices' },
    { key: 'faq', href: at('#faq'), label: 'FAQ' },
    { key: 'notes', href: '/notes', label: 'Notes' },
];
---

<header class="hdr" id="hdr">
    <div class="wrap">
        <a
            class="brand"
            href={home ? '#top' : '/'}
            aria-label={home ? 'Traceway, back to top' : 'Traceway home'}
        >
            <Mark />
            <span>Traceway</span>
        </a>
        <nav class="nav" aria-label="Sections">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        aria-current={current === link.key ? 'page' : undefined}
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>
        <div class="hdr-r">
            <a class="fill sm hdr-cta" href="/dashboard">
                <span class="long">Open the planner</span>
                <span class="mid">Open planner</span>
                <span class="short">Planner</span>
            </a>
            <button
                class="menu-btn"
                id="menu-btn"
                type="button"
                aria-expanded="false"
                aria-controls="menu"
                aria-label="Open the menu"
            >
                <span class="bars" aria-hidden="true"></span>
            </button>
        </div>
    </div>
    <div class="menu" id="menu" hidden>
        <nav class="wrap" aria-label="Sections">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        aria-current={current === link.key ? 'page' : undefined}
                    >
                        {link.label}
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 18 18"
                            fill="none"
                            aria-hidden="true"
                        >
                            <path
                                d="M6 3l6 6-6 6"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </a>
                ))
            }
        </nav>
    </div>
</header>
<div class="menu-scrim" id="menu-scrim" hidden></div>

<script>
    const header = document.getElementById('hdr');
    const button = document.getElementById('menu-btn');
    const menu = document.getElementById('menu');
    const scrim = document.getElementById('menu-scrim');

    if (header && button && menu && scrim) {
        const setOpen = (
            open: boolean,
            moveFocus = false,
        ): void => {
            button.setAttribute('aria-expanded', String(open));
            button.setAttribute(
                'aria-label',
                open ? 'Close the menu' : 'Open the menu',
            );
            menu.hidden = !open;
            scrim.hidden = !open;
            header.classList.toggle('menu-open', open);

            // Focus follows the keyboard. A tap opens the menu without a ring.
            if (open && moveFocus) {
                menu.querySelector<HTMLAnchorElement>('a')?.focus({
                    preventScroll: true,
                });
            } else if (!open && moveFocus) {
                button.focus({ preventScroll: true });
            }
        };

        button.addEventListener('click', (event) => {
            setOpen(
                button.getAttribute('aria-expanded') !== 'true',
                event.detail === 0,
            );
        });
        scrim.addEventListener('click', () => setOpen(false));
        menu.addEventListener('click', (event) => {
            if ((event.target as Element).closest('a')) {
                setOpen(false);
            }
        });
        document.addEventListener('keydown', (event) => {
            if (
                event.key === 'Escape' &&
                button.getAttribute('aria-expanded') === 'true'
            ) {
                setOpen(false, true);
            }
        });
        window
            .matchMedia('(min-width: 900px)')
            .addEventListener('change', () => setOpen(false));
    }
</script>
