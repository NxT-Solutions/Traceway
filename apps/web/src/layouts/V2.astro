---
import outfit400 from '@fontsource/outfit/files/outfit-latin-400-normal.woff2?url';
import outfit500 from '@fontsource/outfit/files/outfit-latin-500-normal.woff2?url';
import outfit600 from '@fontsource/outfit/files/outfit-latin-600-normal.woff2?url';
import '../styles/fonts.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import '../styles/v2.css';
import Consent from '../components/Consent.astro';
import { questions } from '../seo/home';
import * as about from '../seo/site';

interface Props {
    title?: string;
    description?: string;
}

const { title = about.title, description = about.description } = Astro.props;
const canonical = about.absolute(Astro.site, Astro.url.pathname);
const image = about.absolute(Astro.site, '/og.png');

// What the page is, in the words search engines and AI answers read.
const data = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebSite',
            '@id': `${about.absolute(Astro.site, '/')}#website`,
            name: about.name,
            url: about.absolute(Astro.site, '/'),
            description,
        },
        {
            '@type': 'WebApplication',
            '@id': `${about.absolute(Astro.site, '/')}#app`,
            name: about.name,
            url: about.absolute(Astro.site, '/dashboard'),
            description,
            image,
            applicationCategory: 'SportsApplication',
            operatingSystem: 'Web',
            browserRequirements: 'Requires a modern web browser.',
            featureList: [
                ...about.sports.map((sport) => `${sport} loops`),
                ...about.multisport.map((plan) => `${plan} plans`),
                `Routes for ${about.devices.join(', ')}`,
                'Via points',
                'Turn-by-turn directions on Garmin',
            ],
            sameAs: [about.repository],
        },
        {
            '@type': 'FAQPage',
            mainEntity: questions().map(({ question, answer }) => ({
                '@type': 'Question',
                name: question,
                acceptedAnswer: { '@type': 'Answer', text: answer },
            })),
        },
    ],
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        {/* Before the first paint, so what the script draws in is not drawn finished first. The
            loader takes it off again if the script cannot load. csp.mjs hashes it. */}
        <script is:inline>document.documentElement.classList.add('js');</script>
        {/* The first screen uses all three weights, so they load with the page, not after the CSS. */}
        {[outfit400, outfit500, outfit600].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="theme-color" content="#f6f3ea" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="alternate" type="text/markdown" href="/index.md" title="This page as Markdown" />
        <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={about.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="A loop drawn on a map from a pin in Westerlo, and the same loop on a watch." />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={image} />
        <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
    </head>
    <body id="top">
        <Consent />
        <slot />
    </body>
</html>
