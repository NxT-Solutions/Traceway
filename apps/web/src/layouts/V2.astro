---
import outfit400 from '@fontsource/outfit/files/outfit-latin-400-normal.woff2?url';
import outfit500 from '@fontsource/outfit/files/outfit-latin-500-normal.woff2?url';
import outfit600 from '@fontsource/outfit/files/outfit-latin-600-normal.woff2?url';
import '../styles/fonts.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import '../styles/v2.css';
import Consent from '../components/Consent.astro';
import * as about from '../seo/site';
import * as structured from '../seo/structured';

interface Props {
    /** The page's title. Defaults to the site's (src/seo/site.ts). */
    title?: string;
    /** What search engines show. Defaults to the site's. */
    description?: string;
}

const { title = about.title, description = about.description } = Astro.props;
const canonical = about.absolute(Astro.site, Astro.url.pathname);
const image = about.absolute(Astro.site, '/og.png');

// What the page is, in the words search engines and AI answers read.
const data = structured.home(Astro.site, description);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        {/* Before the first paint, so what the script draws in is not drawn finished first. The
            loader takes it off again if the script cannot load. csp.mjs hashes it. */}
        <script is:inline>document.documentElement.classList.add('js');</script>
        {/* The first screen uses all three weights, so they load with the page, not after the CSS. */}
        {[outfit400, outfit500, outfit600].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="theme-color" content="#f6f3ea" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="alternate" type="text/markdown" href="/index.md" title="This page as Markdown" />
        <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        {/* The home-screen manifest is asked for once the page has loaded, so it never waits in line
            with what the first paint needs. csp.mjs hashes it. */}
        <script is:inline>addEventListener('load', () => { const link = document.createElement('link'); link.rel = 'manifest'; link.href = '/manifest.webmanifest'; document.head.append(link); });</script>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={about.name} />
        <meta property="og:locale" content="en_GB" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="A loop drawn on a map from a pin in Westerlo, and the same loop on a watch." />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={image} />
        <script type="application/ld+json" set:html={data} />
    </head>
    <body id="top">
        <Consent />
        <slot />
    </body>
</html>
