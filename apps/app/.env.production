APP_NAME=Traceway
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://traceway.online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr,sentry_logs
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database/traceway.sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# __Host- keeps the cookie to traceway.online itself, over HTTPS, for the
# whole site: the browser refuses it with a Domain or without Secure.
SESSION_COOKIE=__Host-traceway-session
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@traceway.online
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

GRAPHHOPPER_URL=http://graphhopper:8989
ROUTER_DRIVER=valhalla
VALHALLA_URL=https://valhalla1.openstreetmap.de
OSRM_URL=https://router.project-osrm.org

# Set from the TURNSTILE_* secrets at deploy. Empty turns the check off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The admin area's Traffic page reads Cloudflare's totals. The token is set at
# deploy from the CLOUDFLARE_ANALYTICS_TOKEN secret, the ids from variables.
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_WEB_ANALYTICS_SITE_TAG=

# Errors, traces and logs go to Sentry (EU region). The DSN and the release
# are set at deploy from the SENTRY_LARAVEL_DSN secret and the release tag.
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=true

VITE_APP_NAME="${APP_NAME}"
