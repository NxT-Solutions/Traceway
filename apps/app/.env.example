APP_NAME=Traceway
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://traceway.ddev.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,sentry_logs
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

GRAPHHOPPER_URL=http://graphhopper:8989
ROUTER_DRIVER=valhalla
VALHALLA_URL=https://valhalla1.openstreetmap.de
OPENFREEMAP_URL=https://tiles.openfreemap.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
VALHALLA_MAX_REQUEST_METRES=140000
VALHALLA_MAX_REQUEST_POINTS=10
OSRM_URL=https://router.project-osrm.org

# Cloudflare Turnstile on sign-up and password reset. Leave both empty to turn it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The admin area's Traffic page. A read-only Analytics token. Leave empty and the page says it is not connected.
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_WEB_ANALYTICS_SITE_TAG=
CLOUDFLARE_R2_BACKUP_BUCKET=traceway-backups

# Comma-separated addresses that become Super Admin once confirmed.
SUPER_ADMIN_EMAILS=noah.gillard@nxt-solutions.com

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: HELO on the host, mailbox name Traceway, port 2525.
# DDEV sends through host.docker.internal. On the host itself, use 127.0.0.1.
# Production: MAIL_MAILER=resend, RESEND_API_KEY, and a from-address on a domain verified in Resend.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=host.docker.internal
MAIL_PORT=2525
MAIL_USERNAME=Traceway
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@traceway.test"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Errors, traces and logs go to Sentry. Leave the DSN empty to send nothing.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=true

VITE_APP_NAME="${APP_NAME}"

# Accounts riders log in with or connect, under Settings, then Connections. Leave a client empty to hide it.
# Register the callback APP_URL/auth/<service>/callback at each service, such as
# https://traceway.ddev.site/auth/google/callback. Wahoo and Ride with GPS keep the callbacks they were first
# registered with. Each *_REDIRECT_URI in config/services.php can point somewhere else.

# Google: an OAuth client (Web application) at console.cloud.google.com, under APIs & Services, then Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: a Services ID with Sign in with Apple, and a Sign in with Apple key, at developer.apple.com.
# The client id is the Services ID. Apple posts back to /auth/apple/callback. The private key is the .p8 file's
# text on one line, with \n for each line break, in double quotes:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
# Before turning Apple on, register at developer.apple.com, under Certificates, Identifiers & Profiles, then
# Services, then Sign in with Apple for Email Communication: the domain of MAIL_FROM_ADDRESS, its send.
# subdomain (Resend's return path, which carries the SPF record), and MAIL_FROM_ADDRESS itself. In production
# that is traceway.online, send.traceway.online, and noreply@traceway.online. Resend signs with DKIM for the
# domain. Otherwise Apple's private relay drops every Traceway mail to a rider who hid their email.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Facebook: an app with Facebook Login at developers.facebook.com. Callback /auth/facebook/callback.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Instagram: the same kind of app with Instagram Login. Its Instagram app id and secret, not Facebook's.
# Callback /auth/instagram/callback.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# X: a project app at developer.x.com, with OAuth 2.0 for a web app. Callback /auth/x/callback.
X_CLIENT_ID=
X_CLIENT_SECRET=
# GitHub: an OAuth app at github.com/settings/developers. Callback /auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Discord: an application at discord.com/developers/applications, under OAuth2. Callback /auth/discord/callback.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Garmin Connect: an app in Garmin's Connect Developer Program, at developer.garmin.com, once Garmin approves it.
# The client id is the consumer key. Callback /auth/garmin_connect/callback.
GARMIN_CONNECT_CLIENT_ID=
GARMIN_CONNECT_CLIENT_SECRET=
# Wahoo: a developer app at developers.wahooligan.com. Callback /settings/services/wahoo/callback.
# Wahoo also takes the routes Send to device sends.
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
# true once the "email" permission is enabled on the Wahoo app. Until then Wahoo riders type their email to sign up.
WAHOO_REQUEST_EMAIL=false
# Ride with GPS: an API client at ridewithgps.com/api. Callback /settings/services/ride_with_gps/callback.
# Ride with GPS also takes the routes Send to device sends, with the API key.
RIDEWITHGPS_CLIENT_ID=
RIDEWITHGPS_CLIENT_SECRET=
RIDEWITHGPS_API_KEY=
# RunSignup: an OAuth 2.0 client in your RunSignup account. Callback /auth/runsignup/callback.
# prod uses runsignup.com. test uses test.runsignup.com, which needs a client of its own.
RUNSIGNUP_CLIENT_ID=
RUNSIGNUP_CLIENT_SECRET=
RUNSIGNUP_ENVIRONMENT=prod
# OpenStreetMap: an OAuth 2 application at openstreetmap.org, under My Settings, then OAuth 2 applications,
# confidential, allowed to read your user preferences. Callback /auth/openstreetmap/callback.
OPENSTREETMAP_CLIENT_ID=
OPENSTREETMAP_CLIENT_SECRET=
