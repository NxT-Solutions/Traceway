{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "Traceway plans routes for any sport and exports them as course files.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "darkaonline/l5-swagger": "dev-master",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/mcp": "^1.0",
        "laravel/passport": "^13.9",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "resend/resend-php": "^1.16",
        "saloonphp/laravel-plugin": "^5.0",
        "saloonphp/saloon": "^4.0",
        "scalar/laravel": "^0.4.1",
        "sentry/sentry-laravel": "^4.29",
        "socialiteproviders/apple": "^6.1",
        "socialiteproviders/discord": "^4.2",
        "socialiteproviders/instagram": "^5.2",
        "socialiteproviders/manager": "^4.10",
        "socialiteproviders/openstreetmap": "^5.0",
        "socialiteproviders/runkeeper": "^4.1",
        "socialiteproviders/runsignup": "^5.0",
        "socialiteproviders/strava": "^4.1",
        "spatie/laravel-permission": "^8.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phparkitect/phparkitect": "^1.3",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install --frozen-lockfile",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "blade:fix": [
            "bun run blade:fix"
        ],
        "blade:check": [
            "bun run blade:check"
        ],
        "architecture": [
            "phparkitect check"
        ],
        "rector": [
            "rector process"
        ],
        "rector:check": [
            "rector process --dry-run --no-progress-bar"
        ],
        "ci:lint": [
            "Composer\\Config::disableProcessTimeout",
            "@rector:check",
            "@lint:check",
            "@architecture",
            "bun run blade:check",
            "bun run check"
        ],
        "ci:test": [
            "Composer\\Config::disableProcessTimeout",
            "@types:check",
            "bun run types:check",
            "@test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@ci:lint",
            "@ci:test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "php -d pcov.enabled=0 vendor/bin/pest --parallel --compact"
        ],
        "test:smoke": [
            "php -d pcov.enabled=0 vendor/bin/pest --parallel --compact --group=smoke"
        ],
        "test:mutate": [
            "bash tests/with-coverage.sh vendor/bin/pest --mutate --parallel --covered-only --min=80 --ignore-min-score-on-zero-mutations --group=mutation tests/Unit"
        ],
        "test:perf": [
            "k6 run --insecure-skip-tls-verify tests/Performance/smoke.js"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
