{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@traceway/app",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "types:check": "tsc --noEmit",
        "blade:check": "blade-formatter --check-formatted \"resources/views/**/*.blade.php\"",
        "blade:fix": "blade-formatter --write \"resources/views/**/*.blade.php\"",
        "test:browser": "node tests/Browser/planner.mjs && node tests/Browser/wcag.mjs && node tests/Browser/mobile.mjs",
        "test:browser:details": "node tests/Browser/details.mjs",
        "test:browser:screens": "node tests/Browser/screens.mjs"
    },
    "dependencies": {
        "@inertiajs/react": "^3.9.1",
        "@inertiajs/vite": "^3.9.1",
        "@laravel/passkeys": "^0.4.0",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-collapsible": "^1.2.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-navigation-menu": "^1.4.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-toggle": "^1.2.1",
        "@radix-ui/react-toggle-group": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.6",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^0.475.0",
        "maplibre-gl": "^6.12.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vite": "^8.3.4"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@biomejs/biome": "^2.5.15",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "blade-formatter": "^1.44.4",
        "playwright-core": "1.64.1",
        "vite-plus": "0.3.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.64.7",
        "@rollup/rollup-win32-x64-msvc": "4.64.7",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
