{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@traceway/app",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "storybook": "msw init .storybook/msw --no-save && storybook dev --port 6006 --no-open",
        "build-storybook": "msw init .storybook/msw --no-save && storybook build --output-dir storybook-static --quiet",
        "test:storybook": "msw init .storybook/msw --no-save && vitest run --project storybook && vitest run --project storybook-ink",
        "test:storybook:coverage": "msw init .storybook/msw --no-save && vitest run --project storybook --coverage --coverage.reportsDirectory=storybook-coverage/paper && vitest run --project storybook-ink --coverage --coverage.reportsDirectory=storybook-coverage/ink",
        "test:storybook:contrast": "node .storybook/contrast.mjs",
        "design-system": "bun run build-storybook && node .storybook/design-system/build.mjs",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "types:check": "tsc --noEmit",
        "blade:check": "blade-formatter --check-formatted \"resources/views/**/*.blade.php\"",
        "blade:fix": "blade-formatter --write \"resources/views/**/*.blade.php\"",
        "test:browser": "node tests/Browser/planner.mjs && node tests/Browser/wcag.mjs && node tests/Browser/mobile.mjs",
        "test:browser:details": "node tests/Browser/details.mjs",
        "test:browser:screens": "node tests/Browser/screens.mjs"
    },
    "dependencies": {
        "@fontsource/outfit": "^5.2.8",
        "@inertiajs/react": "^3.9.1",
        "@inertiajs/vite": "^3.9.1",
        "@laravel/passkeys": "^0.4.0",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-collapsible": "^1.2.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-navigation-menu": "^1.4.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-toggle": "^1.2.1",
        "@radix-ui/react-toggle-group": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.6",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^1.58.0",
        "maplibre-gl": "^6.12.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-is": "^19.2.0",
        "recharts": "^3.10.1",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@biomejs/biome": "^2.5.15",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@rolldown/plugin-babel": "^0.2.3",
        "@storybook/addon-a11y": "10.6.1",
        "@storybook/addon-docs": "10.6.1",
        "@storybook/addon-links": "10.6.1",
        "@storybook/addon-mcp": "10.6.1",
        "@storybook/addon-vitest": "10.6.1",
        "@storybook/react-vite": "10.6.1",
        "@types/node": "^26.6.5",
        "@vitest/browser-playwright": "5.0.3",
        "@vitest/coverage-v8": "5.0.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "blade-formatter": "^1.44.4",
        "msw": "3.0.2",
        "msw-storybook-addon": "3.0.3",
        "playwright": "1.64.1",
        "playwright-core": "1.64.1",
        "storybook": "10.6.1",
        "vite-plus": "1.3.0",
        "vitest": "5.0.3"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.64.7",
        "@rollup/rollup-win32-x64-msvc": "4.64.7",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "postcss-selector-parser": "^7.1.6",
        "tinypool": "^2.2.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
    }
}
